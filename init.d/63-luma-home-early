#!/bin/sh
# Apply Luma's bind-mount after 2s instead of the default 5s in home.sh boot.
# 64-luma-home still runs as a fallback; home.cjs apply is idempotent.
# Reduces the window where pressing Home catches the stale LG binary.
[ -f /var/lib/luma-home/home.sh ] || exit 0
(
  sleep 2
  sh /var/lib/luma-home/home.sh apply >> /var/lib/luma-home/boot.log 2>&1
  echo "63-luma-home-early: apply done" >> /var/lib/luma-home/boot.log
) &
exit 0
